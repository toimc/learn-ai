{
  "name": "ai-chat-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n docs,mock -c blue,green \"pnpm -C packages/docs dev\" \"pnpm -C packages/mock-server dev\"",
    "dev:docs": "pnpm -C packages/docs dev",
    "dev:mock": "pnpm -C packages/mock-server dev",
    "build": "pnpm -r --filter='./packages/*' run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"packages/**/src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"packages/**/src/**/*.{ts,vue,css}\"",
    "type-check": "pnpm -r --filter=\"./packages/core\" --filter=\"./packages/vue\" --filter=\"./packages/markdown\" --filter=\"./packages/agents\" --filter=\"./packages/server\" exec vue-tsc --noEmit -p tsconfig.json",
    "clean": "pnpm -r exec rm -rf dist",
    "prepare": "simple-git-hooks"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx --no -- commitlint --edit $1"
  },
  "lint-staged": {
    "*.{ts,vue,css}": [
      "prettier --write"
    ],
    "*.{ts,vue}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.5",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  }
}
