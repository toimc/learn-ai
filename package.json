{
  "name": "ai-chat-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -C packages/docs dev",
    "build": "pnpm -r --filter='./packages/*' run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"packages/**/src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"packages/**/src/**/*.{ts,vue,css}\"",
    "type-check": "pnpm -r --filter=\"./packages/core\" --filter=\"./packages/vue\" --filter=\"./packages/markdown\" exec vue-tsc --noEmit -p tsconfig.json",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "jsdom": "^29.1.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.6",
    "vue": "^3.5.34",
    "vue-tsc": "^3.3.0"
  }
}