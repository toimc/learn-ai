{
  "name": "@toimc/dev-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "studio": "mastra dev -e .env",
    "build": "mastra build",
    "start:mastra": "mastra start",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@mastra/core": "^1.60.0",
    "@mastra/libsql": "^1.21.0",
    "@mastra/memory": "^1.27.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@toimc/agents": "workspace:*",
    "@toimc/core": "workspace:*",
    "@toimc/server": "workspace:*",
    "hono": "^4.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "mastra": "^1.26.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
