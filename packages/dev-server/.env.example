# ── 部署模式二选一 ─────────────────────────────────────────────
# 本地开发：配 MASTRA_MODEL 系列，自己用服务端模型调 agents。
# 生产/公网：**全部注释掉**——服务端零 LLM key，访客要真实模型时经
# Playground 顶栏 ⚙ 设置（ProviderSettingsDialog）注册自己的 url + key
# （POST /api/providers，运行时注册不依赖 MASTRA_MODEL；mock 演示与语义
# 检索 EMBEDDING_MODEL 均不受影响）。服务端 key 挂公网会被匿名烧量。
# ───────────────────────────────────────────────────────────────

# mastra agents（可选）：配置后 chat-agent 注册进网关；缺省纯 mock 模式
MASTRA_MODEL=deepseek/deepseek-chat

# 自定义 OpenAI 兼容端点（可选；配了 MASTRA_MODEL 才有意义）
# MASTRA_MODEL_URL=https://your-endpoint/v1

# 自定义端点的 API key（url 场景必传：Mastra url 场景不自动读 provider env）
# MASTRA_MODEL_API_KEY=sk-xxx

# 消除 Studio "Provider not connected" 警告（可选）：Studio 的连接检查只认
# OPENAI_API_KEY 变量名，与 MASTRA_MODEL_API_KEY 同值即可；实际调用仍走上面的配置
# OPENAI_API_KEY=sk-xxx

# 展示名（可选）
# MASTRA_MODEL_NAME=Chat Agent

# 检索等轻量角色的次级模型（可选）：配置则 researcher 等检索角色用此便宜模型，
# writer/reviewer 仍用 MASTRA_MODEL——多 agent 编排演示"按角色选模型"
# MASTRA_SUB_MODEL=deepseek/deepseek-chat

# context7 MCP 的 API key（可选）：配置后 docs-agent 获得 context7__resolve-library-id /
# context7__get-library-docs 两个外部库文档查询工具（stdio 启动 npx @upstash/context7-mcp，
# 连接失败自动降级为不挂载，不影响启动）
# CONTEXT7_API_KEY=ctx7sk-xxx

# 语义检索（可选）：配置后 search_docs 升级「语义+关键词」混合检索。
# 裸模型名走本地 Ollama（先 ollama pull bge-m3 并 pnpm index:docs 入库）；
# 含 provider/ 前缀则配合下面两个变量走云端 OpenAI 兼容端点
# EMBEDDING_MODEL=bge-m3

# embedding 端点与 key（可选；缺省 http://localhost:11434/v1 + 占位 ollama）
# EMBEDDING_MODEL_URL=http://localhost:11434/v1
# EMBEDDING_MODEL_API_KEY=ollama

# 网关 Bearer（可选；设置后 /api/chat 与 /api/models 需携带，/api/health 公开）
# MASTRA_TOKEN=

# Studio 可观测性（可选）：traces/logs，默认开启；设为 false 显式关闭
# MASTRA_TELEMETRY=true

# 服务端口（默认 8787）
# DEV_SERVER_PORT=8787
