# 模型路由串（Mastra 约定 "provider/model"，如 deepseek/deepseek-chat、anthropic/claude-sonnet-4-20250514）
# 对应 provider 的 API key 按其 env 约定命名（如 DEEPSEEK_API_KEY / ANTHROPIC_API_KEY）
MASTRA_APP_MODEL=

# 可选：自定义 OpenAI 兼容端点（设了以后 model 走 { id, url } 对象形态）
MASTRA_APP_MODEL_URL=

# 可选：API 访问令牌；设置后 /api/* 需带 Authorization: Bearer <token>（/health 始终公开）
MASTRA_APP_TOKEN=

# 可选：HTTP 端口（默认 4111，Mastra 生态默认口；与 mock-server 的 npx mastra dev 互斥，勿同时跑）
MASTRA_APP_PORT=4111

# 可选：遥测开关（true 时 Mastra 实例挂 telemetry）
MASTRA_APP_TELEMETRY=
